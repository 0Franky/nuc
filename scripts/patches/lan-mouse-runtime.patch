+
+#[cfg(test)]
+mod nexus_runtime_tests {
+    use super::*;
+    use notify::event::ModifyKind;
+
+    #[tokio::test]
+    async fn windows_modify_any_reloads_and_removes_clients() {
+        let unique = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();
+        let dir = std::env::temp_dir().join(format!("nexus-config-test-{}-{unique}", std::process::id()));
+        fs::create_dir(&dir).unwrap();
+        struct Cleanup(PathBuf);
+        impl Drop for Cleanup {
+            fn drop(&mut self) { let _ = fs::remove_file(self.0.join("config.toml")); let _ = fs::remove_dir(&self.0); }
+        }
+        let _cleanup = Cleanup(dir.clone());
+        let path = dir.join("config.toml");
+        let (tx, rx) = tokio::sync::mpsc::channel(4);
+        let mut config = Config {
+            args: Args::parse_from(["lan-mouse"]),
+            cert_path: dir.join("identity.pem"),
+            config_path: path.clone(), config_dir: dir,
+            config_toml: Some(ConfigToml::default()),
+            watcher: RecommendedWatcher::new(|_| {}, notify::Config::default()).unwrap(),
+            watch_rx: rx,
+        };
+        fs::write(&path, "[[clients]]\nips = [\"192.0.2.1\"]\nposition = \"left\"\nactivate_on_startup = true\n").unwrap();
+        tx.send(Ok(notify::Event::new(EventKind::Modify(ModifyKind::Any)).add_path(path.clone()))).await.unwrap();
+        tokio::time::timeout(std::time::Duration::from_millis(250), config.changed()).await
+            .expect("Windows FILE_ACTION_MODIFIED must reload the configured neighbor").unwrap();
+        assert_eq!(config.clients().len(), 1);
+        assert_eq!(config.clients()[0].pos, Position::Left);
+        fs::write(&path, "clients = []\n").unwrap();
+        tx.send(Ok(notify::Event::new(EventKind::Modify(ModifyKind::Any)).add_path(path))).await.unwrap();
+        tokio::time::timeout(std::time::Duration::from_millis(250), config.changed()).await
+            .expect("Removing the neighbor must also reload").unwrap();
+        assert!(config.clients().is_empty());
+    }
+}
