+#[cfg(test)]
+mod nexus_pin_tests {
+    use super::*;
+    #[test]
+    fn destination_certificate_must_match_the_approved_endpoint() {
+        let cert = vec![1,2,3];
+        let fp = crate::crypto::generate_fingerprint(&cert);
+        let address = "192.0.2.1:4243".parse().unwrap();
+        let keys = HashMap::from([(fp, "pc-id|192.0.2.1:4243".into())]);
+        assert!(destination_matches(&[cert.clone()], address, &keys));
+        assert!(!destination_matches(&[vec![4,5,6]], address, &keys));
+        assert!(!destination_matches(&[cert], "192.0.2.2:4243".parse().unwrap(), &keys));
+        assert!(!destination_matches(&[], address, &keys));
+    }
+}
+
+#[cfg(test)]
+mod nexus_dtls_tests {
+    use super::*;
+    use webrtc_util::conn::Listener;
+    #[tokio::test]
+    async fn handshake_accepts_only_the_pinned_destination() {
+        for correct in [true, false] {
+            let server_cert = Certificate::generate_self_signed(["ignored".into()]).unwrap();
+            let other_cert = Certificate::generate_self_signed(["ignored".into()]).unwrap();
+            let pin = crate::crypto::certificate_fingerprint(if correct { &server_cert } else { &other_cert });
+            let listener = webrtc_dtls::listener::listen("127.0.0.1:0", Config {
+                certificates: vec![server_cert],
+                extended_master_secret: ExtendedMasterSecretType::Require,
+                ..Default::default()
+            }).await.unwrap();
+            let addr = listener.addr().await.unwrap();
+            let keys = Arc::new(RwLock::new(HashMap::from([(pin, format!("pc|{addr}"))])));
+            let client_cert = Certificate::generate_self_signed(["ignored".into()]).unwrap();
+            let (accepted, outgoing) = tokio::join!(listener.accept(), connect(addr, client_cert, keys));
+            assert!(accepted.is_ok());
+            assert_eq!(outgoing.is_ok(), correct);
+            if let Ok((connection, _)) = outgoing { let _ = connection.close().await; }
+            if let Ok((connection, _)) = accepted { let _ = connection.close().await; }
+            listener.close().await.unwrap();
+        }
+    }
+}
